# Enter download mode manually with BOOT and EN before flashing.
CONFIG_ESPTOOLPY_BEFORE_NORESET=y

# Wi-Fi and Classic Bluetooth both fit in the larger factory partition on 2 MB.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Classic Bluetooth SPP
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_BLE_ENABLED=n

# Wi-Fi station for VOFA+ shares the radio with Classic Bluetooth.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
